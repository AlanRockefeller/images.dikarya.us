# Local development settings. Copy to .env and adjust. In production these come
# from the systemd EnvironmentFile (/var/www/images.dikarya.us/.env); never
# commit real values.
APP_ENV=development
BASE_URL=http://127.0.0.1:8000
DATABASE_URL=postgresql+psycopg:///images
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me
# iNaturalist taxon IDs whose descendants are imported (47170 = Fungi).
ROOT_TAXON_IDS=47170
# Where the taxonomy archive is downloaded.
IMPORT_DATA_DIR=./data
# Included in the User-Agent sent to iNaturalist and Mushroom Observer.
CONTACT_EMAIL=
# Licenses shown publicly (default: cc0,pd,cc-by,cc-by-sa,cc-by-nc,cc-by-nc-sa).
# DISPLAY_LICENSES=cc0,pd,cc-by,cc-by-sa
